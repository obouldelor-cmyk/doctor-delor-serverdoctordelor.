
const express = require("express");
const cors = require("cors");
const OpenAI = require("openai");

const app = express();

app.use(cors());
app.use(express.json({ limit: "30kb" }));

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

// Limitation simple des requêtes
const requests = new Map();

app.get("/", (req, res) => {
  res.send("Serveur IA de Doctor Delor opérationnel !");
});

app.post("/api/ask", async (req, res) => {
  try {
    const ip = req.ip;
    const now = Date.now();
    const previous = requests.get(ip);

    if (previous && now - previous.time < 15 * 60 * 1000
        && previous.count >= 10) {
      return res.status(429).json({
        error: "Trop de demandes. Réessaie plus tard."
      });
    }

    if (!previous || now - previous.time >= 15 * 60 * 1000) {
      requests.set(ip, { time: now, count: 1 });
    } else {
      previous.count++;
    }

    const question = req.body.question;

    if (typeof question !== "string" || !question.trim()) {
      return res.status(400).json({
        error: "Écris une question."
      });
    }

    const response = await openai.responses.create({
      model: "gpt-6-luna",
      instructions: "Tu es l'assistant pédagogique médical de Doctor Delor. Réponds en français avec des explications claires, structurées et adaptées aux étudiants en médecine. Précise les incertitudes et ne remplace jamais un professionnel de santé.",
      input: question
    });

    res.json({
      answer: response.output_text
    });

  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Une erreur est survenue. Réessaie plus tard."
    });
  }
});

const PORT = process.env.PORT || 10000;

app.listen(PORT, "0.0.0.0", () => {
  console.log("Doctor Delor fonctionne sur le port " + PORT);
});
